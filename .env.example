# Neon Postgres через Vercel Marketplace.
# Скопіюйте цей файл у .env.local вручну або виконайте:
# vercel env pull .env.local --environment=development --yes

# Основний pooled URL для запитів застосунку.
DATABASE_URL=

# Пряме підключення для майбутніх міграцій та адміністративних операцій.
DATABASE_URL_UNPOOLED=

# Несекретний ідентифікатор Neon-проєкту.
NEON_PROJECT_ID=

# Email-адреси адміністраторів через кому, крапку з комою або пробіл.
# Порівняння не залежить від регістру. Адміністратори схвалюються автоматично,
# а всі інші нові користувачі очікують ручного підтвердження адміністратора.
ADMIN_EMAILS=

# Секретний код першої реєстрації адміністратора. Не передавати у клієнтський код.
# Для локального та production-середовищ використовуйте різні значення.
ADMIN_REGISTRATION_TOKEN=
